# Copy to .env at the workspace root for deployment.
# Next.js reads apps/web/.env.local; copy the NEXT_PUBLIC values there for live mode.
NEXT_PUBLIC_DEMO=1
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Relative URL fetched at runtime, or an HTTPS deployment manifest URL.
NEXT_PUBLIC_DEPLOYMENT_URL=/deployments/monad-testnet.json
# Optional. Enables the WalletConnect row in onboarding; get a project id at cloud.reown.com.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Leave empty until deploying. Never use a funded mainnet key for testing.
PRIVATE_KEY=
HOUSE_ADDRESS=
# Human-readable USDC amounts, converted to 6 decimals by the script.
SEED_USDC=1000
START_PRICE_USDC=10
# Internal test isolation flag, set automatically by Playwright. Leave unset for normal use.
# USURP_E2E=1
# SEED_AMOUNT and START_PRICE are internal 6-decimal integer values populated
# automatically by the deploy wrapper from SEED_USDC and START_PRICE_USDC.
